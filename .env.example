# NoticeBridge Environment Configuration Example
PROJECT_NAME="NoticeBridge"
VERSION="1.0.0"
API_PREFIX="/api/v1"

# Database Configuration
# Local PostgreSQL (SQLAlchemy 2.0 + psycopg 3)
DATABASE_URL="postgresql+psycopg://noticebridge_user:noticebridge_password@localhost:5432/noticebridge_db"
# SQLite development fallback:
# DATABASE_URL="sqlite:///./noticebridge.db"

# Authentication & Security
# WARNING: Set a secure 32+ character random key in production
JWT_SECRET_KEY="replace_with_a_secure_random_secret_in_production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Simulation Mode (NoticeBridge simulates hypothetical financing and buyout scenarios)
FINANCIAL_SIMULATION_MODE=true
SIMULATION_MODE=true

# CORS Allowed Origins (Comma-separated in production)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000"
